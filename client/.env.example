# WebSocket game server. http(s) URLs are converted to ws(s) automatically.
VITE_SERVER_URL=ws://localhost:2567

# Chain overrides. When empty, the client reads GET /config and GET /season
# from the game server's HTTP origin (same host/port as the WebSocket).
VITE_CHAIN_ID=43113
VITE_VAULT_ADDRESS=
VITE_USDC_ADDRESS=

# Optional: unix seconds. Overrides seasonEnd from the server config.
VITE_SEASON_END=
