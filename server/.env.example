# Copy to .env trước khi chạy server (npm run dev:server)
# KHÔNG commit .env hoặc API key.

# ── Bot policy ─────────────────────────────────────────────────────────
# heuristic (mặc định): bot local, không gọi mạng.
# jev: TypeSafe Jev qua OpenRouter, fallback heuristic nếu lỗi/timeout.
# von: model free local (Apache-2.0, CPU) cùng wire protocol /v1/systemone.
BOT_POLICY=heuristic

# Log mọi quyết định policy + lý do fallback.
BOT_LOG_DECISIONS=false

# ── Jev (BOT_POLICY=jev) ───────────────────────────────────────────────
# Chỉ dùng khi BOT_POLICY=jev. Tạo key tại https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

JEV_MODEL=typesafe/jev-1.14
JEV_BASE_URL=https://openrouter.ai/api/v1/systemone

# Toàn bộ chain skill → target → intent trong 1 lượt bot.
JEV_TIMEOUT_MS=6000

# Fallback nếu confidence/margin thấp hơn ngưỡng.
JEV_MIN_CONFIDENCE=0.2
JEV_MIN_MARGIN=0.05

# Backward-compatible alias cho BOT_LOG_DECISIONS.
JEV_LOG_DECISIONS=false

# Optional headers cho OpenRouter attribution.
# JEV_REFERER=https://prism-pact.local
# JEV_TITLE=Prism Pact

# ── Von (BOT_POLICY=von) ───────────────────────────────────────────────
# Chạy local:  pip install "von-sdk>=1.3.7"
#              von serve --host 127.0.0.1 --port 8000 --device cpu --no-chains
# Lần đầu tải ~1.5 GB weights từ Hugging Face.
VON_MODEL=von-1.3.0
VON_BASE_URL=http://127.0.0.1:8000/v1/systemone

# Von nhanh với state ngắn nhưng chậm với state game đầy đủ trên CPU.
# Timeout ngắn để fallback heuristic thay vì treo lượt.
VON_TIMEOUT_MS=2000
VON_MIN_CONFIDENCE=0.2
VON_MIN_MARGIN=0.05

# Optional: Von local không cần auth. Chỉ điền nếu chạy sau proxy có bearer.
# VON_API_KEY=

# ── Server ─────────────────────────────────────────────────────────────
# PORT=2567
# RANKING_FILE=ranking.json
