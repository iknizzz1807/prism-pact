# Copy to .env và điền trước khi deploy Fuji
# Ví deploy phải có AVAX testnet (faucet: https://core.app/tools/testnet-faucet)

PRIVATE_KEY=
FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc

# Ví server dùng để ký commitDraft (có thể trùng ví deploy)
OPERATOR_ADDRESS=

# Số ngày mùa giải
SEASON_DAYS=14

# Sponsor prize mùa 1 (USDC, đơn vị người)
SPONSOR_USDC=500
